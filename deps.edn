{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM).
 ;; This repo is standalone-installable (M2/M4 step 1): every
 ;; dependency is a git coordinate, no :local/root into a monorepo
 ;; checkout. A fresh clone in an empty directory resolves with
 ;; `kbb -M:dev:test` / `clojure -M:dev:test` alone.
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
        ;; jp-go-dds moved to :render-html alias (see NOTE below).
        ;; NOTE (standalone, M2/M4 step 1): jp-go-dds is needed only by
        ;; realty.render-html, but its own deps.edn transitively names
        ;; io.github.kotoba-lang/osaho at https://github.com/kotoba-lang/osaho.git
        ;; (deleted upstream; the lib now lives at lib/kotoba.osaho in
        ;; kotoba-lang/kotoba). Keeping it top-level makes every
        ;; `clojure -M:dev:test` classpath build try to clone that deleted
        ;; repo and fail, even though no test/demo namespace requires
        ;; jp-go-dds. It therefore lives on the :render-html alias below
        ;; (see "What does NOT work" in README). The top-level html/css
        ;; pins above stay: robotics and the render path need them, and
        ;; they are leaf libs with no deleted transitive.
        ;; html/css を top-level で git 座標に固定する。推移依存(:local/root)と
        ;; jp-go-dds(:git/sha)で座標型が違うと tools.deps が版を比較できない。
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.html"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.css"}
        ;; Transitive stdlib floors, pinned top-level so standalone git
        ;; resolution does not compare duplicate :local/root copies of
        ;; the same lib from different git checkouts (kbb: "No known
        ;; ancestor relationship"; tools.deps takes the NEWEST sha).
        io.github.kotoba-lang/error
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.error"}
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.io"}
        io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.json"}
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.bytes"}
        io.github.kotoba-lang/set
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.set"}
        io.github.kotoba-lang/walk
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.walk"}
        io.github.kotoba-lang/spec
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.spec"}
        io.github.kotoba-lang/kudaki
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.kudaki"}
        ;; langgraph (StateGraph runtime) -- was :local/root into the
        ;; monorepo; now a git coordinate into kotoba-lang/kotoba,
        ;; the same shape as every other kotoba dep above and as
        ;; cloud-itonami-isic-8291's own langgraph dep.
        io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.langgraph"}
        ;; optional: realty.corporate-intel's cross-reference into
        ;; cloud-itonami-isic-8291. Only realty.corporate-intel itself
        ;; requires `dossier.*` -- realtorllm/operation/governor have zero
        ;; compile-time dependency on it (the screen fn is plain-injected).
        io.github.cloud-itonami/cloud-itonami-isic-8291
        {:git/url "https://github.com/cloud-itonami/app-itonami-cloud-itonami-isic-8291.git"
         :git/sha "448cc9b93a7d8dc369d1b4b8c64b38e052271453"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  ;; test/'s namespaces minus these, which cannot load on kbb (the full suite stays on :test, fleet JVM gate):
  ;; - realty.corporate-intel-test: reaches dossier.* in cloud-itonami-isic-8291, .kotoba-only on main
  :physai-test {:extra-paths ["test" "test-physai"]
                :main-opts ["-m" "cognitect.test-runner"
                            "-n" "realty.physics-spec-test"
                            "-n" "realty.facts-test"
                            "-n" "realty.governor-contract-test"
                            "-n" "realty.observation-test"
                            "-n" "realty.phase-test"
                            "-n" "realty.registry-test"
                            "-n" "realty.store-contract-test"
                            "-n" "realty.user-role-record-test"]}
  ;; standalone dev -- pin transitive langchain to the same git
  ;; coordinate (was a :local/root into ../../kotoba-lang/langchain).
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:git/url "https://github.com/kotoba-lang/kotoba.git"
          :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
          :deps/root "lib/kotoba.langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "realty.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave5 seq 6).
  ;; jp-go-dds lives here (not top-level): only realty.render-html requires
  ;; jp-go-dds.skin, and jp-go-dds transitively names the deleted
  ;; kotoba-lang/osaho.git repo. See NOTE above / README "What does NOT work".
  :render-html {:extra-deps {io.github.kotoba-lang/jp-go-digital-design-system
                             {:git/url "https://github.com/kotoba-lang/kotoba.git"
                              :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
                              :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
                :main-opts ["-m" "realty.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
